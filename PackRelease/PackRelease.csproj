<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Installed as a .NET global tool: see README.md -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>packrelease</ToolCommandName>
    <PackageId>PackRelease</PackageId>
    <Version>1.3.1</Version>
    <Authors>Insane96</Authors>
    <Description>Builds and publishes CurseForge modpack releases</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\nupkg</PackageOutputPath>
  </PropertyGroup>

</Project>
